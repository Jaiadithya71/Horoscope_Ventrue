{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/app/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/app/style.css"
    },
    {
      "source": "/app.js",
      "destination": "/app/app.js"
    },
    {
      "source": "/i18n.js",
      "destination": "/app/i18n.js"
    },
    {
      "source": "/weekly",
      "destination": "/app/weekly.html"
    },
    {
      "source": "/weekly.js",
      "destination": "/app/weekly.js"
    },
    {
      "source": "/weekly.css",
      "destination": "/app/weekly.css"
    }
  ]
}
