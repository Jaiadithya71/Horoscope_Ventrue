{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/app/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/app/style.css"
    },
    {
      "source": "/app.js",
      "destination": "/app/app.js"
    },
    {
      "source": "/i18n.js",
      "destination": "/app/i18n.js"
    },
    {
      "source": "/weekly",
      "destination": "/app/weekly.html"
    },
    {
      "source": "/weekly.js",
      "destination": "/app/weekly.js"
    },
    {
      "source": "/weekly.css",
      "destination": "/app/weekly.css"
    },
    {
      "source": "/studio",
      "destination": "/app/studio.html"
    },
    {
      "source": "/studio.js",
      "destination": "/app/studio.js"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{docs/**,pipeline/**,extracted/**,tests/**,builder-site/**,benchmarks/**,profiles/**,app/**,node_modules/**,.git/**}"
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.cjs"
}
